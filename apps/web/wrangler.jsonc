// Local development configuration of the Lunt Worker (`pnpm dev`,
// `pnpm build`, `pnpm start`). One Worker hosts everything
// (design.md D-05): the TanStack Start fetch handler, the events queue
// consumer and its dead-letter queue, the daily Cron Trigger, and the
// single SQLite-backed Durable Object that holds every aggregate, the
// outbox and the consumer receipts. The DO applies its schema itself —
// there is no migration step. A deployed configuration drops DEV_TOOLS
// and takes SESSION_SECRET from `wrangler secret put`: see
// `wrangler.production.example.jsonc` and docs/deployment.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunt",
  "main": "app/server.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "http://localhost:3000",
    // Development tools (`/__dev/*`) and the development-only session
    // secret below. Never set in a deployed configuration.
    "DEV_TOOLS": "1",
    "SESSION_SECRET": "lunt-local-development-session-secret",
    // Bearer token of the operations endpoints (`/__ops/*`), development
    // value. A deployed configuration sets its own with `wrangler secret
    // put OPS_TOKEN`, or leaves it unset to turn the endpoints off.
    "OPS_TOKEN": "lunt-local-development-operations-token",
    // Alarm relay tuning, read inside the DO by `readRelayTuning` /
    // `readPruneTuning`.
    "OUTBOX_BATCH_SIZE": "100",
    // Crash-recovery window for an alarm that died mid-claim.
    "OUTBOX_LEASE_MS": "300000",
    // The relay never gives up on an event; from this many failed
    // publishes on, each further failure is logged at error level.
    "OUTBOX_ALERT_AFTER_ATTEMPTS": "5",
    // Processed outbox rows and consumer receipts: 7 days.
    "OUTBOX_RETENTION_MS": "604800000",
    // Account: mail goes to the development inbox (`/__dev/inbox`) and the
    // "Google" login uses the development fake provider
    // (`/__dev/idp/authorize`). Both need DEV_TOOLS=1. A deployed
    // configuration sets MAIL_TRANSPORT=smtp with SMTP_HOST / SMTP_USERNAME
    // (vars) and SMTP_PASSWORD (secret), and EXTERNAL_IDP=google with
    // GOOGLE_CLIENT_ID (var) and GOOGLE_CLIENT_SECRET (secret).
    "MAIL_TRANSPORT": "devInbox",
    "MAIL_FROM": "Lunt <no-reply@lunt.example>",
    "EXTERNAL_IDP": "fake",
    // Login link and code lifetime (15 minutes), the wrong codes that
    // close a login challenge, and the unexpired login mails one address
    // may have at once.
    "LOGIN_CHALLENGE_TTL_MS": "900000",
    "LOGIN_MAX_CODE_ATTEMPTS": "5",
    "LOGIN_MAX_UNEXPIRED_CHALLENGES": "5",
    // Application: an operator may stand in for a region's or occasion's
    // stewards this long after an application went under review (7 days).
    "APPLICATION_PROXY_AFTER_MS": "604800000",
    // Discovery: the radius of the viewer's vicinity in metres, shared by
    // the region list (VW-05) and the map's first range (VW-04).
    "VICINITY_RADIUS_METERS": "3000",
    // Map tiles (VW-04, VW-08): a MapLibre style URL. OpenFreeMap needs no
    // API key; a replacement's sources must carry its attribution, which
    // the map shows (docs/runtime_cloudflare_do.md 「Map tiles」).
    "MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/positron"
  },
  // Photos (design.md D-09): key `photos/{photoId}`, served at /photos/{photoId}.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "lunt-photos" }],
  "durable_objects": {
    "bindings": [{ "name": "LUNT_STATE", "class_name": "LuntStateObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LuntStateObject"] }],
  "queues": {
    // The DO's alarm publishes through this binding.
    "producers": [{ "binding": "EVENTS_QUEUE", "queue": "lunt-events" }],
    "consumers": [
      {
        "queue": "lunt-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "lunt-events-dlq"
      },
      {
        // Keeps each message in the state object for an operator to
        // re-drive (`/__ops/dead-letters`). A message is acked only once
        // stored, so storing gets several tries.
        "queue": "lunt-events-dlq",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 10
      }
    ]
  },
  "triggers": {
    // 15:05 UTC = 00:05 JST, just after the JST calendar day turns
    // (`LocalDate` is the Japan calendar date).
    "crons": ["5 15 * * *"]
  }
}
